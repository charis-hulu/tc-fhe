#!/bin/bash
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -q debug
#PBS -A UIC-HPC
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o tc-fhe-test.log

# ---------------------------------------------------------------------------
# Runs the bounded transitive closure FHE benchmark (CPU boolean backend) on
# a single Polaris node, once per graph size N in $N_VALUES.
#
# Build on the login node first (compute nodes don't have cmake on PATH):
#   cmake -B build -DCMAKE_BUILD_TYPE=Release -DTC_WITH_TFHE=ON \
#         -DTFHE_ROOT=/path/to/tfhe-rs/target/release \
#         -DTC_BUILD_TESTS=OFF -DTC_BUILD_BENCHMARKS=ON
#   cmake --build build --target bench_tfhe -j "$(nproc)"
#
# Then submit from the repo root:
#   qsub scripts/run_polaris.pbs
#
# Override the N sweep or density via qsub -v, e.g.:
#   qsub -v N_VALUES="64 128 256",DENSITY=0.1 scripts/run_polaris.pbs
# ---------------------------------------------------------------------------
set -euo pipefail

cd "${PBS_O_WORKDIR}"

N_VALUES=${N_VALUES:-"8 16 32"}
DENSITY=${DENSITY:-0.2}
SEED=${SEED:-2024}
BUILD_DIR=${BUILD_DIR:-build}

echo "=== Job started on $(hostname) at $(date) ==="
echo "N_VALUES=${N_VALUES}  DENSITY=${DENSITY}  SEED=${SEED}  BUILD_DIR=${BUILD_DIR}"

# --- Generate one graph per N, then run the FHE benchmark on each ----------
for N in ${N_VALUES}; do
    echo "--- Generating graph_N${N} (density=${DENSITY}, seed=${SEED}) ---"
    python3 scripts/gen_graph.py "${N}" --density "${DENSITY}" --seed "${SEED}" --out-dir data

    echo "--- Running bench_tfhe for N=${N} ---"
    "./${BUILD_DIR}/benchmarks/bench_tfhe" "graph_N${N}"
done

echo "=== Job finished at $(date) ==="
echo "Results appended to data/bench_tfhe_results.csv"
