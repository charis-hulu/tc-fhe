#!/bin/bash
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=00:05:00
#PBS -q debug
#PBS -A UIC-HPC
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o tc-fhe-bgv-batched-test.log

# ---------------------------------------------------------------------------
# Quick smoke test for the bgv-batched (OpenFHE, SIMD-packed) backend: 1
# Polaris node, debug queue, a single small graph size (default N=4, T=N).
# Runs bench_bgv_batched (not the examples/ demo binary), so results also
# get appended to data/bench_bgv_batched_results.csv.
#
# Assumes build_bgv_batched/benchmarks/bench_bgv_batched already exists
# (built once on the login node via scripts/build_tc_fhe_bgv_batched.sh).
# This job does not build or load anything -- it just runs that binary.
#
# Submit from the repo root:
#   qsub scripts/run_polaris_bgv_batched_test.pbs
#
# Override the test size via qsub -v, e.g.:
#   qsub -v N=8,T=8 scripts/run_polaris_bgv_batched_test.pbs
# ---------------------------------------------------------------------------
set -euo pipefail

cd "${PBS_O_WORKDIR}"

N=${N:-4}
T=${T:-${N}}
DENSITY=${DENSITY:-0.2}
SEED=${SEED:-2024}
BUILD_DIR=${BUILD_DIR:-build_bgv_batched}
OPENFHE_DIR=${OPENFHE_DIR:-"$HOME/openfhe"}

echo "=== BGV-batched test job started on $(hostname) at $(date) ==="
echo "N=${N}  T=${T}  DENSITY=${DENSITY}  SEED=${SEED}  BUILD_DIR=${BUILD_DIR}"

export LD_LIBRARY_PATH="${OPENFHE_DIR}/lib:${LD_LIBRARY_PATH:-}"

# --- Generate one graph and run the FHE closure once ------------------------
echo "--- Generating graph_N${N} (density=${DENSITY}, seed=${SEED}) ---"
python3 scripts/gen_graph.py "${N}" --density "${DENSITY}" --seed "${SEED}" --out-dir data

echo "--- Running bench_bgv_batched for N=${N}, T=${T} ---"
"./${BUILD_DIR}/benchmarks/bench_bgv_batched" --graph="graph_N${N}" --T="${T}"

echo "=== BGV-batched test job finished at $(date) ==="
