#!/bin/bash
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=00:40:00
#PBS -q debug
#PBS -A UIC-HPC
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o tc-fhe-test.log

# ---------------------------------------------------------------------------
# Quick smoke test: 1 Polaris node, debug queue, a single small graph size.
# Use this to confirm the build + FHE run work end-to-end before submitting
# the full sweep in run_polaris.pbs.
#
# Build on the login node first (compute nodes don't have cmake on PATH):
#   cmake -B build -DCMAKE_BUILD_TYPE=Release -DTC_WITH_TFHE=ON \
#         -DTFHE_ROOT=/path/to/tfhe-rs/target/release \
#         -DTC_BUILD_TESTS=OFF -DTC_BUILD_BENCHMARKS=ON
#   cmake --build build --target bench_tfhe -j "$(nproc)"
#
# Then submit from the repo root:
#   qsub scripts/run_polaris_test.pbs
#
# Override the test size via qsub -v, e.g.:
#   qsub -v N=32 scripts/run_polaris_test.pbs
# ---------------------------------------------------------------------------
set -euo pipefail

cd "${PBS_O_WORKDIR}"

N=${N:-32}
DENSITY=${DENSITY:-0.2}
SEED=${SEED:-2024}
BUILD_DIR=${BUILD_DIR:-build}

echo "=== Test job started on $(hostname) at $(date) ==="
echo "N=${N}  DENSITY=${DENSITY}  SEED=${SEED}  BUILD_DIR=${BUILD_DIR}"

# --- Generate one graph and run the FHE benchmark once ----------------------
echo "--- Generating graph_N${N} (density=${DENSITY}, seed=${SEED}) ---"
python3 scripts/gen_graph.py "${N}" --density "${DENSITY}" --seed "${SEED}" --out-dir data

echo "--- Running bench_tfhe for N=${N} ---"
"./${BUILD_DIR}/benchmarks/bench_tfhe" "graph_N${N}"

echo "=== Test job finished at $(date) ==="
echo "Result appended to data/bench_tfhe_results.csv"
