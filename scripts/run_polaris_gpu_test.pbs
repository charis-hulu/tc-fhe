#!/bin/bash -l
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -q debug-scaling
#PBS -A UIC-HPC
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o tc-fhe-gpu-test.log

# ---------------------------------------------------------------------------
# GPU smoke test: 1 Polaris node (4x A100), debug queue, a single small graph
# size. Confirms the CUDA build + GPU FHE run work end-to-end before
# investing in a GPU sweep.
#
# Build on the login node first (compute nodes don't have cmake on PATH).
# tfhe-rs' GPU C API needs a separate clone + feature set from the CPU build:
#   git clone https://github.com/zama-ai/tfhe-rs.git ~/tfhe-rs-gpu
#   source set_env.sh                    # gcc, not nvc -- see build_tfhe_rs.sh
#   module load cudatoolkit-standalone    # load AFTER set_env.sh, for nvcc
#   TFHE_RS_DIR=~/tfhe-rs-gpu FEATURES=high-level-c-api,gpu scripts/build_tfhe_rs.sh
#   scripts/build_tc_fhe_gpu.sh
#
# Then submit from the repo root:
#   qsub scripts/run_polaris_gpu_test.pbs
#
# Override the test size via qsub -v, e.g.:
#   qsub -v N=32 scripts/run_polaris_gpu_test.pbs
# ---------------------------------------------------------------------------
set -euo pipefail

cd "${PBS_O_WORKDIR}"

N=${N:-32}
DENSITY=${DENSITY:-0.2}
SEED=${SEED:-2024}
BUILD_DIR=${BUILD_DIR:-build_gpu}

# bench_tfhe_gpu is dynamically linked against libcudart.so.12 -- the compute
# node needs the CUDA runtime on LD_LIBRARY_PATH to load it. `module use` is
# required first: cudatoolkit-standalone lives under /soft/modulefiles, which
# isn't on this node's default MODULEPATH (same reason cmake was "unknown"
# until set_env.sh added it, back when we first debugged the CPU build).
module use /soft/modulefiles
module load cudatoolkit-standalone/12.2.2

echo "=== GPU test job started on $(hostname) at $(date) ==="
echo "N=${N}  DENSITY=${DENSITY}  SEED=${SEED}  BUILD_DIR=${BUILD_DIR}"

echo "--- GPUs visible on this node ---"
nvidia-smi -L

echo "--- Generating graph_N${N} (density=${DENSITY}, seed=${SEED}) ---"
python3 scripts/gen_graph.py "${N}" --density "${DENSITY}" --seed "${SEED}" --out-dir data

echo "--- Running bench_tfhe_gpu for N=${N} ---"
"./${BUILD_DIR}/benchmarks/bench_tfhe_gpu" "graph_N${N}"

echo "=== GPU test job finished at $(date) ==="
echo "Result appended to data/bench_tfhe_gpu_results.csv"
