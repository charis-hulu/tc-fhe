#!/bin/bash
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=00:05:00
#PBS -q debug
#PBS -A UIC-HPC
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o tc-fhe-bgv-test.log

# ---------------------------------------------------------------------------
# Quick smoke test for the bgv (OpenFHE, unbatched) backend: 1 Polaris node,
# debug queue, a single small graph size (default N=4, T=N).
# Runs bench_bgv (not the examples/ demo binary), so results also get
# appended to data/bench_bgv_results.csv.
#
# Build on the login node first (compute nodes don't have cmake on PATH):
#   cmake -B build -DCMAKE_BUILD_TYPE=Release -DTC_WITH_BGV=ON \
#         -DCMAKE_PREFIX_PATH=/path/to/openfhe-install
#   cmake --build build --target bench_bgv -j "$(nproc)"
# (see README.md "With BGV (OpenFHE)")
#
# Submit from the repo root:
#   qsub scripts/run_polaris_bgv_test.pbs
#
# Override the test size via qsub -v, e.g.:
#   qsub -v N=8,T=8 scripts/run_polaris_bgv_test.pbs
#
# Larger N/T need more circuit depth, which makes OpenFHE auto-pick a
# bigger ring dimension -- and the default plaintext modulus (65537) is
# only NTT-compatible up to ring dimension 32768 (N=4). Past that, pass a
# bigger NTT-friendly prime, e.g. the one already used for N=8 in
# tests/test_bgv_batched_tc.cpp -- see docs/plaintext_modulus_issue.md:
#   qsub -v N=8,T=8,PLAINTEXT_MODULUS=786433 scripts/run_polaris_bgv_test.pbs
#
# The 5-minute walltime above only covers the default N=4 smoke test.
# Larger N roughly doubles the ring dimension per depth jump, which makes
# every homomorphic op much slower -- N=8,T=8 alone exceeded 5 minutes.
# Override walltime on the qsub command line for bigger runs, e.g.:
#   qsub -l walltime=01:00:00 -v N=8,T=8,PLAINTEXT_MODULUS=786433 \
#     scripts/run_polaris_bgv_test.pbs
# ---------------------------------------------------------------------------
set -euo pipefail

cd "${PBS_O_WORKDIR}"

N=${N:-4}
T=${T:-${N}}
DENSITY=${DENSITY:-0.2}
SEED=${SEED:-2024}
BUILD_DIR=${BUILD_DIR:-build}
OPENFHE_DIR=${OPENFHE_DIR:-"$HOME/openfhe"}
PLAINTEXT_MODULUS=${PLAINTEXT_MODULUS:-65537}
# OpenFHE spawns one OpenMP thread per core by default; on a shared node
# with a high core count this can blow past the pthread limit and abort
# with "pthread_create ... value 11" before printing anything. Cap it.
OMP_NUM_THREADS=${OMP_NUM_THREADS:-2}

echo "=== BGV test job started on $(hostname) at $(date) ==="
echo "N=${N}  T=${T}  DENSITY=${DENSITY}  SEED=${SEED}  BUILD_DIR=${BUILD_DIR}  OMP_NUM_THREADS=${OMP_NUM_THREADS}"

export LD_LIBRARY_PATH="${OPENFHE_DIR}/lib:${LD_LIBRARY_PATH:-}"
export OMP_NUM_THREADS

# --- Generate one graph and run the FHE closure once ------------------------
echo "--- Generating graph_N${N} (density=${DENSITY}, seed=${SEED}) ---"
python3 scripts/gen_graph.py "${N}" --density "${DENSITY}" --seed "${SEED}" --out-dir data

echo "--- Running bench_bgv for N=${N}, T=${T} (plaintext_modulus=${PLAINTEXT_MODULUS}) ---"
"./${BUILD_DIR}/benchmarks/bench_bgv" --graph="graph_N${N}" --T="${T}" \
    --bgv-plaintext-modulus="${PLAINTEXT_MODULUS}"

echo "=== BGV test job finished at $(date) ==="
echo "Results appended to data/bench_bgv_results.csv"
